PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5500
JWT_SECRET=replace-this-with-a-long-random-secret-before-deploying
JWT_EXPIRES_IN=7d
DATABASE_PATH=./data/safestreet.sqlite
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# First startup provisions this admin only if the database has no admin user.
ADMIN_NAME=SafeStreet Administrator
ADMIN_EMAIL=admin@safestreet.local
ADMIN_PASSWORD=ChangeMe123!

# Optional: set to enable OpenAI-assisted report classification. If omitted,
# the API uses transparent local keyword rules and identifies it as heuristic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Password reset links are logged to the console in development.
APP_BASE_URL=http://localhost:5500
